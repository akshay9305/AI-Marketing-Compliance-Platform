{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mars Chocolate Marketing Template - en-US",
  "description": "Schema for Mars chocolate holiday marketing email template",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "brand_name": { "type": "string", "default": "MARS Chocolate" },
        "tagline": { "type": "string", "default": "Indulge in Sweetness" }
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "headline": { "type": "string", "default": "Sweet Holiday Deals Are Here!" },
        "body_text": { "type": "string" },
        "cta_text": { "type": "string", "default": "Shop Now" },
        "cta_url": { "type": "string", "format": "uri", "default": "https://www.mars.com/made-by-mars/mars-wrigley" }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "link_url": { "type": "string", "format": "uri" }
        }
      },
      "default": [
        { "name": "Snickers", "description": "Packed with peanuts, caramel & nougat", "link_url": "https://www.snickers.com/" },
        { "name": "M&M's", "description": "Colorful candy-coated chocolate", "link_url": "https://www.mms.com/" },
        { "name": "Twix", "description": "Cookie bars with caramel & chocolate", "link_url": "https://www.twix.com/" }
      ]
    },
    "promo": {
      "type": "object",
      "properties": {
        "headline": { "type": "string", "default": "Exclusive Member Offer" },
        "description": { "type": "string", "default": "Use code below for 20% off your next order!" },
        "promo_code": { "type": "string", "default": "SWEET20" }
      }
    },
    "social_links": {
      "type": "object",
      "properties": {
        "facebook": { "type": "string", "format": "uri", "default": "https://www.facebook.com/Mars" },
        "instagram": { "type": "string", "format": "uri", "default": "https://www.instagram.com/marsglobal/" },
        "twitter": { "type": "string", "format": "uri", "default": "https://twitter.com/MarsGlobal" },
        "youtube": { "type": "string", "format": "uri", "default": "https://www.youtube.com/user/Mars" }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "company_address": { "type": "string", "default": "Mars, Incorporated | 6885 Elm Street, McLean, VA 22101" },
        "contact_url": { "type": "string", "format": "uri", "default": "https://www.mars.com/contact-us" },
        "privacy_url": { "type": "string", "format": "uri", "default": "https://www.mars.com/privacy" },
        "preferences_url": { "type": "string", "format": "uri", "default": "https://www.mars.com/preferences" }
      }
    }
  },
  "locale": "en-US"
}
