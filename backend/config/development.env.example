# Marketing Compliance Platform - Development Configuration
# Copy this file to development.env and fill in your credentials

# Application Configuration
APP_VERSION=0.1.0
LIMIT_PYTHON_MEMORY=false

# Logging Configuration
LOG_LEVEL=DEBUG

# Azure OpenAI Configuration (for LLMProxy)
# Required: Set these values from your Azure OpenAI resource
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional: Tiktoken model name for token counting
AZURE_OPENAI_TIKTOKEN_MODEL_NAME=gpt-4o-mini

# Optional: Embedding model configuration
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Legacy OpenAI LLM Configuration (deprecated - use Azure OpenAI above)
# LLM_APP_NAME=your-app-name
# LLM_PASSWORD=your-password
# LLM_CERT_PATH=config/certificate.crt
# LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=10000
# LLM_BASE_URL=https://your-proxy-url

# Database Configuration (SQLite is used by default)
# DATABASE_URL=sqlite:///marketing_compliance.db

# CORS Configuration (for frontend connection)
# CORS_ORIGINS=http://localhost:3000

# Server Configuration
# HOST=0.0.0.0
# PORT=8000
